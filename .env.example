# Copy to .env. Generate long random values; never commit .env.
NODE_ENV=production
PORT=3000
MIHWAR_APP_ID=mihwar-self-hosted
MIHWAR_DOMAIN=example.com
SESSION_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_TOKEN=REPLACE_WITH_A_LONG_RANDOM_ONE_TIME_SETUP_TOKEN

# MySQL
MYSQL_DATABASE=mihwar
MYSQL_USER=mihwar
MYSQL_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD
DATABASE_URL=mysql://mihwar:REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD@db:3306/mihwar

# S3-compatible private object storage (local MinIO in docker-compose; may be replaced with Cloudflare R2)
STORAGE_DRIVER=s3
S3_BUCKET=mihwar-private
S3_REGION=us-east-1
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=https://storage.example.com
STORAGE_DOMAIN=storage.example.com
S3_ACCESS_KEY_ID=REPLACE_WITH_MINIO_ACCESS_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_MINIO_SECRET_AT_LEAST_32_CHARS
S3_FORCE_PATH_STYLE=true
S3_SERVER_SIDE_ENCRYPTION=false

# Optional independent AI provider (OpenAI-compatible API). Leave empty to disable AI features.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Google Maps: browser key MUST be restricted by allowed HTTP referrers; server key stays private.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_API_KEY=

# Optional legacy Manus integrations. Standalone authentication/storage no longer require these.
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
MANUS_API_URL=
MANUS_API_KEY=
MANUS_API_BROWSER_KEY=
OWNER_OPEN_ID=

# Paymob Unified Checkout (configure only after merchant approval and Sandbox credentials)
# Regional API origins: Egypt / KSA / UAE. The currency must match the configured integration ID(s).
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_CHECKOUT_BASE_URL=https://eg.checkout.paymob.com/
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_PAYMENT_METHODS=
PAYMOB_CURRENCY=EGP
PAYMOB_NOTIFICATION_URL=https://example.com/api/payments/paymob/webhook
PAYMOB_REDIRECTION_URL=https://example.com/parent?payment=return
PAYMOB_EXPIRATION_SECONDS=3600

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/previews/mihwar_command_hub.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
